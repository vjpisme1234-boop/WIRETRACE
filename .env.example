# Copy this file to .env for local development (expo start).
# For production builds, set these as EAS environment variables instead
# (eas env:set --environment production/preview/development).
# Never commit a real .env file — it is gitignored.

# Required for the app to work out of the box with zero user setup (and for
# app-store reviewers who won't have their own key). Get a free key at
# https://aistudio.google.com/apikey — no payment method needed.
EXPO_PUBLIC_GEMINI_DEFAULT_KEY=

# Optional model overrides — leave blank to use the defaults in utils/openrouter.ts
EXPO_PUBLIC_GEMINI_MODEL=
EXPO_PUBLIC_ANTHROPIC_MODEL=
EXPO_PUBLIC_OPENAI_MODEL=
EXPO_PUBLIC_OPENROUTER_MODEL=

# Set to claude-opus-5 to opt in to the most accurate schematic reader. It
# costs roughly 2.5x Sonnet 5 per scan and is billed to whichever key the
# customer supplied, which is why it is not the default.
#   EXPO_PUBLIC_ANTHROPIC_MODEL=claude-opus-5
# Adding a second Anthropic attempt gives you an Opus-primary chain with
# Sonnet as the rescue rung. Leave blank for a single Anthropic attempt.
EXPO_PUBLIC_ANTHROPIC_MODEL_FALLBACK=
