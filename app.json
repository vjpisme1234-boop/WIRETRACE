{
  "expo": {
    "name": "WireTrace AI",
    "slug": "wiretrace-ai",
    "description": "AI-powered wire schematic reader with premium subscriptions for electricians and technicians.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/newly.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/newly.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vjpisme1234.wiretraceai",
      "infoPlist": {
        "NSCameraUsageDescription": "WireTrace AI needs camera access to photograph wire schematics for analysis.",
        "NSPhotoLibraryUsageDescription": "WireTrace AI needs photo library access to import wire schematic images for analysis."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/newly.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.vjpisme1234.wiretraceai",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/newly.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "expo-camera",
      "react-native-purchases",
      [
        "expo-image-picker",
        {
          "photosPermission": "WireTrace AI needs photo library access to import wire schematic images for analysis.",
          "cameraPermission": "WireTrace AI needs camera access to photograph wire schematics for analysis."
        }
      ]
    ],
    "scheme": "wiretraceai",
    "privacy": "public",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "privacyPolicyUrl": "https://wiretrace.ai/privacy",
      "termsOfServiceUrl": "https://wiretrace.ai/terms"
    }
  }
}